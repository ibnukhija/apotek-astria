<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HALAMAN UTAMA -->
        <LinearLayout
            android:id="@+id/layoutMenuProfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#2A9D8F"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Profil &amp; Pengaturan"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvOwner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Login sebagai: Owner"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Apotek Astria"
                    android:textColor="#212121"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRingkasanAlamat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Alamat apotek"
                    android:textColor="#757575"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnBukaEditProfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#2A9D8F"
                    android:text="Edit Profil Apotek"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMenuAkun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="#FFFFFF"
                android:text="Kelola Akun Karyawan     ›"
                android:textColor="#333333" />

            <Button
                android:id="@+id/btnMenuNotifikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="Preferensi Notifikasi Stok     ›"
                android:textColor="#333333" />

            <Button
                android:id="@+id/btnMenuEditProfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="Edit Profil Apotek     ›"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- HALAMAN EDIT PROFIL -->
        <LinearLayout
            android:id="@+id/layoutEditProfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#2A9D8F"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Edit Profil Apotek"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnKembaliEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E0F2EF"
                android:text="‹ Kembali"
                android:textColor="#20796F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nama apotek (tercetak di struk)"
                android:textColor="#555555"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etNamaApotek"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:hint="Nama apotek"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Alamat (tercetak di struk)"
                android:textColor="#555555"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etAlamat"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edittext"
                android:gravity="top"
                android:hint="Alamat apotek"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Latitude (opsional)"
                android:textColor="#555555"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etLatitude"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_edittext"
                android:hint="Contoh: -7.8166"
                android:inputType="numberSigned|numberDecimal"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Longitude (opsional)"
                android:textColor="#555555"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etLongitude"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_edittext"
                android:hint="Contoh: 112.0116"
                android:inputType="numberSigned|numberDecimal"
                android:padding="12dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#2A9D8F"
                android:text="SIMPAN"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- HALAMAN PREFERENSI NOTIFIKASI -->
        <LinearLayout
            android:id="@+id/layoutNotifikasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#2A9D8F"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Preferensi Notifikasi"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnKembaliNotifikasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E0F2EF"
                android:text="‹ Kembali"
                android:textColor="#20796F" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp">

                <Switch
                    android:id="@+id/switchNotifikasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notifikasi stok menipis"
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Batas minimum stok"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etBatasStok"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="10"
                    android:inputType="number"
                    android:padding="12dp"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSimpanNotifikasi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#2A9D8F"
                    android:text="SIMPAN"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- HALAMAN KELOLA AKUN -->
        <LinearLayout
            android:id="@+id/layoutAkun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#2A9D8F"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Kelola Akun"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnKembaliAkun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E0F2EF"
                android:text="‹ Kembali"
                android:textColor="#20796F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Kelola akun karyawan melalui halaman pengelolaan akun."
                android:textColor="#555555"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnKelolaKaryawan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#2A9D8F"
                android:text="+ Kelola Akun Karyawan"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>