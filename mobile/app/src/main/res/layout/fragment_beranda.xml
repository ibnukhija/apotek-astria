<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

            <!-- Top Header (Logo dan Nama Apotek) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="A"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="#2A9D8F"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_nama_apotek_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Apotek Astria 2 Farma"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Kartu Ringkasan Penjualan Utama (Hijau Teal) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#2A9D8F"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_label_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Penjualan"
                        android:textColor="#E8F4F2"
                        android:textSize="14sp" />

                    <!-- Tombol/Chip Filter Periode -->
                    <TextView
                        android:id="@+id/tv_filter_periode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_chip_white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Harian"
                        android:textColor="#2A9D8F"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_total_penjualan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_label_total"
                        android:layout_marginTop="8dp"
                        android:text="Rp 0"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_jumlah_transaksi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:text="0 transaksi hari ini"
                        android:textColor="#E8F4F2"
                        android:textSize="12sp" />

                    <!-- Placeholder Ikon Grafik (Bisa diganti image riil jika ada) -->
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="#FFFFFF"
                        android:alpha="0.3"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Kotak Peringatan Stok (Soft Orange) -->
            <LinearLayout
                android:id="@+id/layout_peringatan_stok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_peringatan_stok"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="#D97706"/>

                <TextView
                    android:id="@+id/tv_peringatan_stok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0 obat hampir habis"
                    android:textColor="#B45309"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Judul Bagian Transaksi Terbaru -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transaksi Terbaru"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_lihat_semua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Lihat Semua"
                    android:textColor="#2A9D8F"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Kontainer Daftar Transaksi -->
            <LinearLayout
                android:id="@+id/layout_list_transaksi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Karena ini halaman dashboard, kita bisa menampilkan "Loading"
                     atau "Data Kosong" secara dinamis di Kotlin nanti. -->
                <ProgressBar
                    android:id="@+id/pb_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:theme="@style/Widget.AppCompat.ProgressBar" />

                <!-- Item transaksi akan dimuat secara dinamis oleh Kotlin di sini -->
            </LinearLayout>

    </LinearLayout>
</ScrollView>
